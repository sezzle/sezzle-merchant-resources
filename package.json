  "type": "module",
  "dependencies": {
    "@babel/node": "^7.26.0",
    "@formatjs/cli": "^6.3.14",
    "@lokalise/node-api": "^15.0.0",
    "adm-zip": "^0.5.16",
    "chalk": "^5.4.1",
    "css-select": "^5.1.0",
    "ejs": "^3.1.10",
    "node-fetch": "^3.3.2",
    "nth-check": "^2.1.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "http-server": "http-server -d .",
    "start:local": "cd local && http-server",
    "translate": "bun run translate:pull && bun run translate:extract && bun run translate:push && echo \"\nPlease wait...\" && sleep 10 && bun run translate:pull",
    "translate:extract": "formatjs extract 'app/**/*.ts*' --ignore='**/*.{d,spec,test}.{tsx,tsx}' --out-file app/translations/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format simple",
    "translate:pull": "PROJECT_ID='4684505165ddb6a9ca5538.26034218' babel-node --presets @babel/preset-env -- internals/scripts/pull_translations.mjs",
    "translate:push": "PROJECT_ID='4684505165ddb6a9ca5538.26034218' babel-node --presets @babel/preset-env -- internals/scripts/push_translations.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-istanbul": "^3.0.0"
  }
}
